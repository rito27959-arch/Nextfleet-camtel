<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<!--
  NexFleet CAMTEL — Traccar en conteneur (hébergement Railway ou CAMTEL). Aucun secret ici.
  Avec CONFIG_USE_ENVIRONMENT_VARIABLES=true, Traccar lit chaque clé dans l'environnement (forward.url → FORWARD_URL,
  forward.header → FORWARD_HEADER) : l'URL interne de la passerelle et le secret partagé sont fournis par le déploiement.
  La base interne H2 est dans /opt/traccar/data (volume persistant).
-->
<properties>
    <entry key='database.driver'>org.h2.Driver</entry>
    <entry key='database.url'>jdbc:h2:./data/database</entry>
    <entry key='database.user'>sa</entry>
    <entry key='database.password'></entry>
    <entry key='web.port'>8082</entry>
    <entry key='osmand.port'>5055</entry>
    <entry key='forward.type'>json</entry>
    <entry key='forward.retry.enable'>true</entry>
    <entry key='forward.retry.delay'>1000</entry>
    <entry key='forward.retry.count'>8</entry>
    <entry key='forward.retry.limit'>1000</entry>
    <entry key='geocoder.enable'>false</entry>
    <entry key='logger.console'>true</entry>
</properties>
