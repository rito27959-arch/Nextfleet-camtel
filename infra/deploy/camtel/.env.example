# Copier en .env (droits 600) et remplir. Ne JAMAIS versionner .env.
NF_VERSION=0.4.0
NF_ENVIRONMENT=PREPROD                     # DEMO pour une instance de démonstration (données fictives)
NF_API_DOMAIN=nexfleet.camtel.cm
NF_GPS_DOMAIN=gps.nexfleet.camtel.cm
NF_ACME_EMAIL=dsir@camtel.cm

# Secrets : générer chacun avec   openssl rand -base64 48
NF_DB_PASSWORD=
NF_MISSION_TOKEN_KEY=
NF_TRACCAR_FORWARD_SECRET=
NF_TRACCAR_PASSWORD=
NF_BOOTSTRAP_ADMIN_LOGIN=admin
NF_BOOTSTRAP_ADMIN_PASSWORD=               # 12 caractères et plus ; à changer après la première connexion

# Démonstration uniquement (NF_ENVIRONMENT=DEMO)
NF_DEMO_PASSWORD=
NF_DEMO_SIMULATOR=false
NF_BACKUP_RETENTION_DAYS=14
