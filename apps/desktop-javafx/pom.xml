<?xml version="1.0" encoding="UTF-8"?>
<!-- Client JavaFX. Compilé par Maven en CI (GitHub Actions) et hors ligne par tools/build-offline.sh. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cm.camtel.nextfleet</groupId>
        <artifactId>nextfleet-parent</artifactId>
        <version>0.6.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>nextfleet-desktop</artifactId>
    <name>NexFleet — client bureau JavaFX (Windows, Linux)</name>

    <dependencies>
        <dependency>
            <groupId>cm.camtel.nextfleet</groupId>
            <artifactId>nextfleet-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency><groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId><version>${javafx.version}</version></dependency>
        <dependency><groupId>org.openjfx</groupId><artifactId>javafx-swing</artifactId><version>${javafx.version}</version></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>${jackson.version}</version></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <resources>
            <resource><directory>src/main/resources</directory></resource>
            <!-- Catalogue 3D partagé avec Android (modèles à licence redistribuable, voir shared/assets3d/LICENCES.md). -->
            <resource>
                <directory>../../shared/assets3d</directory>
                <targetPath>cm/camtel/nextfleet/desktop/assets3d</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>cm.camtel.nextfleet.desktop.NextfleetDesktopApp</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <!-- Copie des dépendances pour jpackage (voir docs/BUILD.md) -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-libs</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/libs</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
