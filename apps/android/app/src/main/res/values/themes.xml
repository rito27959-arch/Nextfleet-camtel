<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NexFleet" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/nf_accent</item>
        <item name="android:colorPrimaryDark">@color/nf_navy</item>
        <item name="android:colorAccent">@color/nf_accent</item>
        <item name="android:windowBackground">@color/nf_bg</item>
        <item name="android:textColorPrimary">@color/nf_text</item>
        <item name="android:textColorSecondary">@color/nf_muted</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <!-- Lancement : fond bleu nuit et logo, remplacé par Theme.NexFleet dès que l'écran de connexion est prêt -->
    <style name="Theme.NexFleet.Launch" parent="Theme.NexFleet">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.NexFleet.Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/nf_accent</item>
        <item name="android:fontFamily">@font/inter_regular</item>
    </style>
</resources>
